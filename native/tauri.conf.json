{
  "productName": "Resonite MCP",
  "version": "1.0.0",
  "identifier": "ai.fleet.resonite-mcp",
  "build": {
    "frontendDist": "../web_sota/dist",
    "devUrl": "http://localhost:10978",
    "beforeDevCommand": "npm --prefix ../web_sota run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resonite MCP — Agent Lab",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/resonite-mcp-backend.exe",
            "resources/.env.example"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "install-mode": "currentUser",
        "installer-hooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "shell": { "open": true },
    "fs": { "requireLiteralLeadingDot": false },
    "process": { "all": true }
  }
}


