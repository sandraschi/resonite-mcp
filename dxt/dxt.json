{
  "dxt_version": "0.1",
  "name": "resonite-mcp",
  "version": "0.1.0",
  "description": "Resonite social VR platform MCP server for natural language control of avatars, worlds, and ProtoFlux scripting",
  "author": {
    "name": "Sandra Schipal"
  },
  "license": "MIT",
  "homepage": "https://github.com/sandraschi/resonite-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandraschi/resonite-mcp"
  },
  "server": {
    "type": "python",
    "entry_point": "src/resonite_mcp/server.py",
    "mcp_config": {
      "command": "python",
      "args": [
        "-m",
        "resonite_mcp"
      ],
      "env": {
        "PYTHONPATH": "${__dirname}/src",
        "PYTHONUNBUFFERED": "1",
        "RESONITE_OSC_HOST": "127.0.0.1",
        "RESONITE_OSC_PORT": "9000"
      }
    }
  },
  "dependencies": {
    "python": ">=3.8",
    "fastmcp": ">=2.13.1,<2.14.0",
    "python-osc": ">=1.8.0",
    "pydantic": ">=2.0",
    "aiohttp": ">=3.8.0"
  },
  "platforms": ["windows", "macos", "linux"],
  "categories": ["gaming", "virtual-reality", "automation", "scripting"],
  "keywords": ["resonite", "vr", "osc", "protoflux", "social-vr", "mcp"],
  "resonite": {
    "osc_port": 9000,
    "supported_features": [
      "avatar_control",
      "world_management",
      "protoflux_scripting",
      "inventory_management",
      "session_management",
      "social_interactions"
    ]
  }
}
