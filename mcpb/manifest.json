{
  "manifest_version": "0.2",
  "name": "resonite-mcp",
  "version": "1.2.0",
  "description": "Resonite social VR platform MCP server for natural language control of avatars, worlds, and ProtoFlux scripting",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "run_server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","run_server.py"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "health_check", "description": "health_check" },
    { "name": "api_v1_tool", "description": "api_v1_tool" },
    { "name": "get_logs", "description": "Query the activity log." },
    { "name": "logs_stats", "description": "Get activity log statistics (counts by level/kind)." },
    { "name": "logs_export", "description": "Export the activity log as JSON or CSV." },
    { "name": "clear_logs", "description": "Clear the activity log." },
    { "name": "root", "description": "Root endpoint with server information." },
    { "name": "get_osc_status", "description": "Get status of all running OSC servers." },
    { "name": "send_osc_message_route", "description": "Send an OSC message." },
    { "name": "start_osc_server_endpoint", "description": "Start an OSC server." },
    { "name": "stop_osc_server_endpoint", "description": "Stop an OSC server." },
    { "name": "get_received_messages_endpoint", "description": "Get received OSC messages." },
    { "name": "clear_osc_buffer_endpoint", "description": "Clear the OSC message buffer for a specific port." },
    { "name": "start_resonite_session", "description": "Start a new Resonite session." },
    { "name": "get_session_status", "description": "Get current session status." },
