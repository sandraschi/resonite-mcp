    { "name": "set_avatar_locomotion", "description": "Set avatar locomotion mode." },
    { "name": "kill_avatar_sequences", "description": "Kill all avatar sequences." },
    { "name": "execute_protoflux", "description": "Execute a ProtoFlux script." },
    { "name": "load_world", "description": "Load a world." },
    { "name": "end_session", "description": "End the current session." },
    { "name": "get_platform_info", "description": "Get Resonite platform information." },
