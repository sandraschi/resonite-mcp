    { "name": "rl_destroy_slot", "description": "Destroy a slot and all its children." },
    { "name": "rl_batch", "description": "Execute multiple ResoniteLink operations atomically (dataModelOperationBatch, protocol 0.13.1)." },
    { "name": "rl_reflect", "description": "Reflection API (protocol 0.13.1).     Without component_type: list all supported component types...." },
    { "name": "list_cloud_sessions", "description": "list_cloud_sessions" },
    { "name": "get_cloud_session", "description": "Get full metadata for a specific public session." },
    { "name": "world_root", "description": "Get the Root slot of the currently connected Resonite world." },
    { "name": "world_children", "description": "List direct children of any slot (use 'Root' for top level)." },
    { "name": "world_node", "description": "Get full slot/component data by ref ID." },
    { "name": "world_write_field", "description": "Update a specific field/property in Resonite." },
    { "name": "inject_file", "description": "inject_file" },
    { "name": "list_asset_files", "description": "Scan the canonical asset directory for a given category.      Categories:       avatars      → ~/..." },
    { "name": "list_vrm_files", "description": "Scan ~/.avatarmcp/models/ for .vrm files.     Returns list of {name, path, size_bytes} objects.  ..." },
    { "name": "import_vrm", "description": "Inject a VRM avatar into the connected world.      NOT IMPLEMENTED: ResoniteLink (protocol 0.13.1..." },
    { "name": "control_move", "description": "Control avatar movement.     Sends OSC messages to Resonite (typically localhost:9000).     Requi..." },
    { "name": "control_view", "description": "Toggle first/third person view.     Requires 'ThirdPerson' parameter in the avatar." },
    { "name": "world_map_data", "description": "Get spatial data for 2D map visualization.     Scans the world for active users and important slots." },
