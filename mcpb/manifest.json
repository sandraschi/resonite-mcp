    { "name": "rl_disconnect", "description": "Disconnect from ResoniteLink." },
    { "name": "rl_status", "description": "Get ResoniteLink connection status and session info." },
    { "name": "rl_discover", "description": "Discover ResoniteLink sessions on the LAN (UDP 12512, protocol 0.12.0+)." },
    { "name": "rl_read_field", "description": "Read a component's data (type + members) by component ID." },
    { "name": "rl_write_field", "description": "Write one member on a component (updateComponent). Requires 'member'." },
    { "name": "rl_get_node", "description": "Get slot or component info by ref ID." },
    { "name": "rl_get_children", "description": "List direct children of a slot." },
    { "name": "rl_add_slot", "description": "Add a named child slot under a parent slot." },
    { "name": "rl_add_component", "description": "Add a component to a slot. component_type is the fully-qualified C# type name." },
