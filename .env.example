# Resonite MCP configuration — copy to .env and fill in your values
# See docs/INSTALLATION.md for full setup guide

# -------------------------------------------------
# MCP Server transport
# -------------------------------------------------
# MCP_TRANSPORT=stdio        # stdio (Claude Desktop) or http (Tauri/standalone)
MCP_PORT=10979
MCP_HOST=127.0.0.1

# -------------------------------------------------
# Resonite OSC communication
# -------------------------------------------------
RESONITE_OSC_HOST=127.0.0.1
RESONITE_OSC_PORT=9000

# -------------------------------------------------
# Resonite Cloud API (optional — for REST tools)
# -------------------------------------------------
# RESONITE_TOKEN=            # Your Resonite session token
# RESONITE_USER_ID=          # Your Resonite user ID (U-...)

# -------------------------------------------------
# ResoniteLink WebSocket (optional)
# -------------------------------------------------
# RESONITELINK_HOST=localhost
# RESONITELINK_PORT=4242

# -------------------------------------------------
# Cross-fleet integration (optional)
# -------------------------------------------------
# MCP_BRIDGE_URLS=           # Comma-separated URLs of other MCP servers
# RESONITE_LLM_BASE_URL=     # LLM base URL for agentic sampling fallback

# -------------------------------------------------
# Tauri native app
# -------------------------------------------------
RESONITE_TAURI=0
